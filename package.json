{
  "name": "mimicache",
  "version": "0.2.1",
  "private": true,
  "description": "MIMIC Is Merely an In-memory Cache: a small, zero-dependency, Redis-compatible in-memory cache server in pure Node.js. Built for IBM i (PASE) and anywhere else Redis can't be installed.",
  "keywords": [
    "cache",
    "redis-compatible",
    "resp",
    "key-value",
    "in-memory",
    "ttl",
    "ibmi",
    "ibm-i",
    "as400",
    "pase"
  ],
  "license": "Apache-2.0",
  "author": "Mateusz Milkowski",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mimic": "dist/cli.js",
    "mimicache": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "start": "node dist/cli.js",
    "test": "tsc -p tsconfig.test.json && node scripts/run-tests.mjs",
    "test:compat": "tsc -p tsconfig.test.json && node scripts/run-tests.mjs compat",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "ioredis": "^6.0.0",
    "redis": "^6.2.1",
    "typescript": "^6.0.3"
  }
}
